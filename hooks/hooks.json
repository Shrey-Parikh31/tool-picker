{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:/c/Program Files/nodejs\" node \"${CLAUDE_PLUGIN_ROOT}/hooks/first-prompt.js\"",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\first-prompt.js\" }",
            "timeout": 5,
            "statusMessage": "Picking tools..."
          }
        ]
      }
    ]
  }
}
